# ── LLM provider (auto-detected from whichever key is set) ──────────
# Option A — Nous Portal (use this if you have Nous balance):
#   Get the key at https://portal.nousresearch.com → API Keys
#   Base URL: https://inference-api.nousresearch.com/v1 (OpenAI-compatible)
NOUS_API_KEY=
# Option B — OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional overrides:
# LLM_PROVIDER=nous            # nous | openrouter | auto
# LLM_MODEL=deepseek/deepseek-v4-flash-0731

# ── Databases (used by docker-compose / TimescaleDB mode) ─────────────
TSDB_PASSWORD=change-me
NEO4J_PASSWORD=change-me
QDRANT_API_KEY=

# Storage backend: sqlite dev mode by default.
# Switch to TimescaleDB when Docker stack is up:
#   DATABASE_URL=postgresql://agonistes:<TSDB_PASSWORD>@localhost:5432/agonistes
DATABASE_URL=sqlite:///data/agonistes_dev.db

# ── Free-tier API keys (optional; feeds degrade gracefully without them)
FRED_API_KEY=
BLS_API_KEY=
DUNE_API_KEY=

# ── Runtime ───────────────────────────────────────────────────────────
DEV_MODE=true
LOG_LEVEL=INFO
