# ── LLM provider (auto-detected from whichever key is set) ──────────
# Option A — Nous Portal (use this if you have Nous balance):
#   Get the key at https://portal.nousresearch.com → API Keys
#   Base URL: https://inference-api.nousresearch.com/v1 (OpenAI-compatible)
NOUS_API_KEY=
# Option B — OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional overrides:
# LLM_PROVIDER=nous            # nous | openrouter | auto
# LLM_MODEL=deepseek/deepseek-v4-flash-0731

# ── Databases (used by docker-compose / TimescaleDB mode) ─────────────
TSDB_PASSWORD=change-me
NEO4J_PASSWORD=change-me
QDRANT_API_KEY=

# ── Graph / vector / cache service endpoints (GAP 1–3) ─────────────────
# Neo4j (bolt) + credentials
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Qdrant vector store (REST)
QDRANT_URL=http://localhost:6333
# Redis cache / LangGraph state checkpointing
REDIS_URL=redis://localhost:6379
# Grafana admin password (defaults to "admin" if unset)
GRAFANA_PASSWORD=admin
# Optional: a dedicated OpenAI key. The Qdrant pipeline embeds via the
# configured LLM provider (NOUS_API_KEY / OPENROUTER_API_KEY) using
# openai/text-embedding-3-small (1536-dim) automatically — you only need
# OPENAI_API_KEY if you want to embed via direct OpenAI instead. With no key
# at all it falls back to local sentence-transformers all-MiniLM-L6-v2 (384).
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Storage backend: sqlite dev mode by default.
# Switch to TimescaleDB when Docker stack is up:
#   DATABASE_URL=postgresql://agonistes:<TSDB_PASSWORD>@localhost:5432/agonistes
DATABASE_URL=sqlite:///data/agonistes_dev.db

# ── Free-tier API keys (optional; feeds degrade gracefully without them)
FRED_API_KEY=
BLS_API_KEY=
DUNE_API_KEY=
# Dune queries to run (name=query_id pairs). The query IDs must be queries you
# own or that are shared with your Dune account. Create them at dune.com.
#   DUNE_QUERY_IDS=btc_exchange_netflow=1234567,eth_stablecoin_flows=7654321

# ── Runtime ───────────────────────────────────────────────────────────
DEV_MODE=true
LOG_LEVEL=INFO
